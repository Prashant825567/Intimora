# Server-only settings. Never prefix secrets with VITE_ or put them in public/.
# Set either the discovery URL or a fixed API upstream, not both.
API_DISCOVERY_URL=
# API_PROXY_UPSTREAM=

# Optional comma-separated, exact hostnames for the API and external media CDNs.
# API_ALLOWED_HOSTS=
# API_MEDIA_ALLOWED_HOSTS=

# At least 32 random characters. Use the same value across all app instances.
# PROXY_TOKEN_SECRET=

# Local development only: allow a loopback HTTP API for testing.
# API_ALLOW_LOOPBACK=1
