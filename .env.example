# Optional PUBLIC discovery endpoint. It is included in the browser bundle.
# Leave unset to use the existing public Worker. Never include a password,
# access token, signed query string, or any other secret in this value.
# INTIMORA_PUBLIC_API_DISCOVERY_URL=https://discovery.example/api/get-server

# Optional PUBLIC, exact HTTPS origin allowlist for sending Firebase ID tokens.
# Leave unset for the two currently trusted backend origins. Update only after
# reviewing every origin; it is bundled in the browser and must not be secret.
# INTIMORA_PUBLIC_AUTH_BACKENDS=https://api-intimora.vercel.app,https://intimora-api1.vercel.app

# Referral details stay disabled until EVERY trusted backend sanitizes other
# users' private fields. See README.md before enabling this PUBLIC build flag.
# INTIMORA_PUBLIC_SAFE_REFERRALS=1

# Public like-count polling remains off until all backends implement the
# versioned, privacy-safe count API and a shared atomic store (see README.md).
# INTIMORA_PUBLIC_LIVE_LIKES=1

# Optional PUBLIC TubeCorporate campaign URL for the sponsored videos. The normal
# place to set it is src/config/partner-embed.ts; this variable overrides that
# file. Accepts one embed page (https://desi-porntube.com/embed/762647/?source=…)
# or a campaign CSV feed (https://desiporn.tube/admin/feeds/embed/?…feed_format=csv…),
# which the build turns into /partner-feed.json. The campaign `source` parameter
# is added automatically when it is missing.
# INTIMORA_PUBLIC_PARTNER_EMBED_URL=https://desi-porntube.com/embed/762647/?source=1849513610

# Build-time bound for reading the campaign feed (500-60000 ms, default 10000).
# INTIMORA_PARTNER_FEED_TIMEOUT_MS=10000
# Set to 1 to skip the feed request entirely (offline builds and tests).
# INTIMORA_PARTNER_FEED_OFFLINE=1

# The build also resolves the VAST tag once and publishes /ad-fallback.json, so a
# pre-roll still plays when a browser is not allowed to read the tag (CORS).
# Set to 1 to skip that build-time request (offline builds and tests).
# INTIMORA_AD_PROBE_OFFLINE=1

# Optional PUBLIC HilltopAds Video VAST tag for the pre-roll ad. The normal place
# to set it is src/config/vast.ts; this variable overrides that file. Set it to
# an empty string to turn pre-roll ads off. It is a public ad tag, never a secret.
# INTIMORA_PUBLIC_VAST_TAG_URL=https://surprisedplate.com/d.m/xxxx
